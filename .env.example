# ==============================================================================
# OPTIMUS - Event Management Platform Environment Variables (MongoDB Edition)
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env.local` or `.env` for local development:
#    cp .env.example .env.local
# 2. Make sure MongoDB is running locally (e.g., via MongoDB Compass on port 27017).
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL MONGODB (Database & Authentication)
# ------------------------------------------------------------------------------
# Used for all event data, registrations, profiles, and local auth sessions.
# View and manage your data locally in MongoDB Compass.
# ------------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/optimus

# ------------------------------------------------------------------------------
# 2. EMAIL NOTIFICATIONS (Nodemailer via Google OAuth2)
# ------------------------------------------------------------------------------
SENDER_EMAIL=your-email@gmail.com
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=your-google-oauth-client-secret
GMAIL_REFRESH_TOKEN=your-google-oauth-refresh-token

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS (Alternative SMTP Configuration)
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
